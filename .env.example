# Telegram Bot Token (from @BotFather)
BOT_TOKEN=8290140755:AAH8kBCR2uoc0E3dex1arF794Ax7kG4GzYU

# Environment mode: development, production
ENVIRONMENT=production

# Database URL
# For production (PostgreSQL async): postgresql+asyncpg://postgres:postgres@postgres:5432/telegram_referral_bot
# For local / testing without Postgres service: sqlite+aiosqlite:///./data/bot.db
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Redis URL for anti-spam rate limiting and caching
# For production Docker: redis://redis:6379/0
# For local fallback if redis not running, leaves empty to use in-memory fallback
REDIS_URL=redis://localhost:6379/0

# Optional: Administrator Log Channel / Chat ID where moderation and referral events will be forwarded
ADMIN_LOG_CHAT_ID=

# Scheduler Interval in seconds (default: 60)
DEADLINE_CHECK_INTERVAL_SECONDS=60

# Default Group Referral Settings
DEFAULT_REFERRAL_DEADLINE_HOURS=24
DEFAULT_REQUIRED_REFERRALS=1
DEFAULT_FAILURE_ACTION=RESTRICT
DEFAULT_WARNING_LIMIT=3
