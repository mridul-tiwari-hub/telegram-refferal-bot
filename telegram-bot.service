[Unit]
Description=Telegram Referral Growth & Group Management Bot
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/telegram-referral-bot
EnvironmentFile=/opt/telegram-referral-bot/.env
ExecStart=/usr/bin/python3 -m app.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
